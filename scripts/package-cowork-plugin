#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DIST="$ROOT/dist"

cd "$ROOT"

VERSION="$(sed -n 's/^version *= *"\(.*\)"/\1/p' Cargo.toml | head -1)"
VERSION="${VERSION:-0.0.0}"
OUT="$DIST/chaos-substrate-cowork-plugin-${VERSION}.zip"

mkdir -p "$DIST"
rm -f "$OUT"

if command -v claude >/dev/null 2>&1; then
  claude plugin validate "$ROOT"
fi

cargo build --release >&2

# Everything the plugin needs to run from an unpacked copy: manifests, the
# wrapper + release binary, the skill, sources to rebuild, migrations, config
# examples and the short docs. Optional entries are skipped when absent so
# the script never fails on a doc that moved.
FILES=(
  .claude-plugin
  .codex-plugin
  .mcp.json
  bin
  skills
  scripts/package-cowork-plugin
  target/release/chaos
  src
  migrations
  Cargo.toml
  Cargo.lock
  LICENSE
  NOTICE
  README.md
  CHANGELOG.md
  docker-compose.yml
  chaos-substrate.example.toml
  chaos.example.toml
)
OPTIONAL=(
  ARCHITECTURE.md
  RUNBOOK.md
  AGENTS.md
  CLAUDE.md
  docs/EDITOR_SETUP.md
  docs/OLLAMA_SETUP.md
  docs/claude_code_mcp.example.json
)

INCLUDE=()
for f in "${FILES[@]}"; do
  if [ ! -e "$f" ]; then
    printf 'missing required file: %s\n' "$f" >&2
    exit 1
  fi
  INCLUDE+=("$f")
done
for f in "${OPTIONAL[@]}"; do
  if [ -e "$f" ]; then
    INCLUDE+=("$f")
  fi
done

zip -qr "$OUT" "${INCLUDE[@]}" -x '*/features_memory/*' -x '*.DS_Store'

cp -f "$OUT" "$DIST/chaos-substrate-cowork-plugin.zip"

printf 'Wrote %s\n' "$OUT"
printf 'Wrote %s\n' "$DIST/chaos-substrate-cowork-plugin.zip"
