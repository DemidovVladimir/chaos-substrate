{
  "description": "Chaos Substrate code-memory context hooks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'h=\"${CLAUDE_PLUGIN_ROOT}/hooks/chaos-hook.sh\"; [ -f \"$h\" ] && exec sh \"$h\" PreToolUse || exit 0'",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'h=\"${CLAUDE_PLUGIN_ROOT}/hooks/chaos-hook.sh\"; [ -f \"$h\" ] && exec sh \"$h\" PostToolUse || exit 0'",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
